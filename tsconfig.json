{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["es2019"],
    "module": "es2015",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["google-apps-script"]
  },
  "include": ["src/*.ts"]
}
